{
  "name": "claros",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "bash scripts/test.sh",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "db:generate": "drizzle-kit generate --config drizzle/drizzle.config.ts",
    "db:migrate": "bash scripts/migrate.sh",
    "release:dry": "bash scripts/release/assemble.sh && bash scripts/release/verify.sh"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.22.0",
    "tsx": "^4.16.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  }
}
