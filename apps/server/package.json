{
  "name": "@claros/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "claros": "bin/claros.mjs"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch --env-file ../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@claros/core": "workspace:*",
    "@claros/adapters": "workspace:*",
    "@claros/api": "workspace:*",
    "@claros/db": "workspace:*",
    "@claros/worker": "workspace:*",
    "@claros/scheduler": "workspace:*",
    "@claros/brain-oss": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "fastify": "^4.28.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
