# Mailforge - Environment Configuration
# Copy to .env and fill in values.
#
# QUOTING: Always single-quote values that contain special characters
# (& $ # spaces etc). The .env parser handles single-quoted, double-quoted,
# and unquoted values. Single quotes are safest for connection strings.

# Edition: "community" (default) or "cloud"
MAILFORGE_EDITION=community

# Node environment: "development" for local/self-host dev, "production" for prod.
# Controls console login fallback (allowed only outside production).
# If unset, treated as production (fail-safe: closed).
NODE_ENV=development

# Postgres connection string (required).
# Single-quote values containing special chars (passwords with & $ # etc).
# Used by: Drizzle ORM (API queries) and pg-boss (job queue, separate pool).
# pg-boss creates its own "pgboss" schema here automatically on first start.
# Port 5433: the docker-compose stack maps container:5432 to host:5433
# to avoid collision with any host-installed Postgres on 5432.
# Also the default target for `pnpm db:migrate` (local migrations).
DATABASE_URL='postgres://mailforge:mailforge@localhost:5433/mailforge'

# Production database (Neon direct endpoint) - used only by `pnpm db:migrate -- --prod`.
# Self-hosters without Neon: leave this commented out. You only need DATABASE_URL.
# For Neon: use the DIRECT endpoint (no -pooler hostname, no ?pgbouncer=true).
# The migrate script refuses pooled endpoints and refuses to hit Neon without --prod.
# PRODUCTION_DATABASE_URL='postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require'

# Server
PORT=3000
HOST=0.0.0.0

# Bootstrap: initial admin email for automated provisioning (optional).
# When the tenants table is empty AND this var is set, creates the default
# tenant and owner user at boot. Ignored once a tenant exists.
# If unset (the default), the server logs a one-time claim URL at startup
# for browser-based account creation. Use SEED_ADMIN_EMAIL only for headless
# deployments or CI where a browser claim is impractical.
# SEED_ADMIN_EMAIL=

# Auto-migrate on startup (local/compose only).
# When exactly "true", applies pending community schema migrations on boot.
# NEVER set this in Cloud / against Neon - use scripts/migrate.sh instead.
# Absent or any other value = migrations do NOT run (fail-safe closed).
# docker-compose.yml sets this to true automatically.
# MAILFORGE_MIGRATE_ON_BOOT=true

# LLM provider (BYO key - OpenAI-compatible endpoint)
# Any endpoint implementing the /v1/chat/completions shape works.
# The provider must support response_format: { type: "json_object" } for
# reliable flow compilation. If it does not, compilation may still succeed
# (the system prompt instructs JSON output) but failures are more likely.
# In all cases, Zod schema validation catches non-conforming output and
# fails the compile cleanly rather than corrupting anything.
#
# Tested providers:
#   OpenAI:     baseUrl=https://api.openai.com/v1         model=gpt-4o
#               Supports response_format natively. Reference implementation.
#
#   Claude:     baseUrl=https://api.anthropic.com/v1/     model=claude-sonnet-4-6
#               Anthropic's OpenAI-compatible layer. No proxy needed.
#               Caveats:
#                 - response_format is IGNORED by this layer. JSON output relies
#                   on the system prompt instruction only; Zod validation catches
#                   non-conforming responses (compile fails, never corrupts).
#                 - Anthropic positions this layer as intended for testing and
#                   evaluation, not as a production-grade path. Self-hosters
#                   choosing Claude should be aware of this positioning.
#               See model names: https://docs.anthropic.com/en/docs/about-claude/models
#
#   Gemini:     baseUrl=https://generativelanguage.googleapis.com/v1beta/openai  model=gemini-2.0-flash
#               Supports response_format natively.
#
#   Groq:       baseUrl=https://api.groq.com/openai/v1    model=llama-3.3-70b-versatile
#               Supports response_format natively.
#
#   Ollama:     baseUrl=http://localhost:11434/v1          model=llama3
#               No API key needed. JSON mode support varies by model.
#
# LLM credentials are stored encrypted per-tenant in the llm_configs table.
# Write them via PUT /v1/settings/llm or the operator CLI:
#   echo '{"provider":"openai","api_key":"sk-...","base_url":"...","model":"gpt-4o"}' \
#     | node apps/server/bin/mailforge.mjs llm set <tenant_slug>
# The optional embedding_model field in the same JSON payload controls which
# model is used for KB entry embeddings (default: text-embedding-3-small,
# must produce vector(1536)).
# ENCRYPTION_KEY is required for this; see below.

# Encryption key for credentials at rest (LLM configs, transport configs).
# 32 bytes, base64-encoded (44 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required when storing or reading encrypted credentials. If unset, LLM config
# storage and flow compilation will fail with a clear error. The server still
# starts (the quickstart path does not need encryption until an LLM is configured).
# ENCRYPTION_KEY=

# Embedding model is configured as part of the LLM config (see above).
# The embedding_model field in the llm set JSON payload overrides the default.
# No separate embedding env vars: the same LLM config row provides the
# API key, base URL, and embedding model for both chat and embedding calls.

# Transport configuration (email provider credentials) is stored encrypted
# per-tenant in the transport_configs table. Write via PUT /v1/settings/transport
# or the operator CLI:
#   echo '{"provider":"resend","from_email":"hi@co.com","api_key":"re_..."}' \
#     | node apps/server/bin/mailforge.mjs transport set <tenant_slug>
# ENCRYPTION_KEY is required for this; see below.

# Auth
# No auth-specific env vars required. Sessions use database-stored UUIDs.
# Magic link delivery uses the configured transport (see above).

# Unsubscribe token signing key (HMAC-SHA256).
# Used to sign stateless unsubscribe tokens embedded in outgoing email headers.
# PERMANENT: this key cannot be rotated without breaking every unsubscribe link
# in already-delivered email, which is a compliance failure. Generate once,
# store permanently, back up securely. At least 32 random bytes, any encoding.
# A missing key fails closed: the drain reverts messages to 'approved' rather
# than sending without a valid signing key. The server starts without this key;
# sending is blocked until you set it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# UNSUBSCRIBE_SIGNING_KEY=

# Base URL for magic link generation (no trailing slash).
# Defaults to http://localhost:PORT in development.
# BASE_URL='http://localhost:3000'

# Dashboard URL for /auth/verify redirects (no trailing slash).
# After a successful magic link verification the browser is redirected here.
# Defaults to BASE_URL when not set. In self-host mode both are the same host.
# In Cloud, set this to the app. subdomain when the SPA is served separately.
# In production, warn if this is a loopback or non-https URL.
# DASHBOARD_URL='http://localhost:3000'

# Static serving of the built dashboard SPA (self-host mode).
# Default: true for community edition, false for cloud edition.
# When "true", Fastify serves apps/dashboard/dist/ and adds a SPA catch-all
# fallback for unknown paths. Set to "false" when an external server (e.g. the
# Cloud Worker) serves static assets instead.
# An explicit value here overrides the edition-based default in both directions.
# If set to "true" and apps/dashboard/dist does not exist, a warning is logged
# and static serving is skipped; API routes are unaffected.
# MAILFORGE_SERVE_DASHBOARD=true

# Seed concurrency test: dedicated isolated database for apps/server/tests/seed.test.ts.
# Must not share a database with other test suites (auth.test.ts etc.).
# Created automatically by docker-compose initdb (docker/initdb/01-seed-test-db.sh).
# No manual setup needed if you use the compose stack.
# SEED_TEST_DATABASE_URL='postgres://mailforge:mailforge@localhost:5433/mailforge_seed_test'

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Doctor command: override the /version URL used by `mailforge doctor`.
# Defaults to BASE_URL (--prod) or http://localhost:3000 (local).
# Set this when the API is behind a hostname not reflected in BASE_URL.
# MAILFORGE_DOCTOR_URL='https://app.example.com'

# ---------------------------------------------------------------------------
# Hosted service (public site, signup, plans). All OFF by default: a self-hosted
# install is unlimited and "/" is the dashboard. Turn on only to run Mailforge
# as a service that sells plans.
# ---------------------------------------------------------------------------

# Serve the public landing/pricing/legal pages and self-serve signup.
# MAILFORGE_PUBLIC_SITE=true
# MAILFORGE_SUPPORT_EMAIL=support@yourdomain.com
# MAILFORGE_LEGAL_NAME=Your Company Ltd

# Enforce plan limits: contacts, monthly emails, team seats, trial expiry, and
# the small "Sent with Mailforge" credit on the Free plan. Existing workspaces on
# "free" get the Free limits; set a larger plan on any that should not.
# MAILFORGE_ENFORCE_PLANS=true
# Public site URL for the credit link (falls back to BASE_URL).
# MAILFORGE_SITE_URL=https://yourdomain.com

# SMTP destination rules. On a hosted service a customer types in their own mail server, so by
# default (whenever MAILFORGE_PUBLIC_SITE or MAILFORGE_ENFORCE_PLANS is true) the server refuses to
# connect to loopback, private, link-local (cloud metadata) and other internal addresses, and only
# allows the usual mail ports. A self-hosted install is unrestricted. Override either way:
# MAILFORGE_RESTRICT_SMTP_HOSTS=true
# Trusted relays that skip the rules (comma list), for example one inside your own network:
# MAILFORGE_SMTP_ALLOWED_HOSTS=relay.internal.example.com
# Replace the allowed ports (default 25,465,587,2465,2525):
# MAILFORGE_SMTP_ALLOWED_PORTS=25,465,587

# Managed sending: Mailforge sends customers' email through YOUR Resend account, so a customer
# does not need an email provider of their own. On only when the API key is set. Use a Resend
# account of its own for this, not the one that sends your login emails. Full setup: guide/SENDING.md
# MAILFORGE_MANAGED_RESEND_API_KEY=re_...
# Signing secret of the Resend webhook that points at https://YOUR-APP/webhooks/resend-platform
# MAILFORGE_MANAGED_RESEND_WEBHOOK_SECRET=whsec_...
# A verified address on a domain you own, used until a customer verifies their own domain.
# Leave out to require a verified domain before anyone can send.
# MAILFORGE_MANAGED_SHARED_FROM=notifications@mail.yourdomain.com
# Emails per day per workspace while on the shared address (default 100).
# MAILFORGE_MANAGED_SHARED_DAILY_LIMIT=100
# Switch managed sending off without removing the key:
# MAILFORGE_MANAGED_SENDING=false

# Online billing with Paystack (card subscriptions). On when the secret key is set;
# Paystack signs webhooks with this same key, so there is no separate hash.
# Full setup: guide/BILLING.md
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_CURRENCY=USD
# Any currency other than USD needs a rate: units of that currency per 1 US dollar. Prices are set
# in USD; the charge is the USD price times this rate, rounded UP to a whole unit (Growth $49 at
# 15.5 is GHS 760). Without a valid rate billing stays OFF, so nobody is charged the dollar figure
# in cedis. Check the market rate and add a margin; revisit it from time to time.
# PAYSTACK_USD_RATE=15.5

# Behind a reverse proxy or host (Render, Fly, nginx, Cloudflare)? Set this so the per-IP limits (signup,
# admin sign-in) see each visitor's real address instead of the proxy's. true = trust the proxy headers;
# a number (1 to 10) = trust exactly that many proxies in front. Leave unset when the app is exposed directly,
# where trusting the header would let a client choose its own address.
# MAILFORGE_TRUST_PROXY=true

# Platform admins: comma-separated emails of the people who run this service. They get
# an Admin console (all workspaces, plans, suspension). Sign-in is by emailed link, so
# list only mailboxes you control. Full guide: guide/ADMIN.md
# MAILFORGE_PLATFORM_ADMINS=you@yourdomain.com
# Run the admin console as its own deployment instead: its own port, sign-in and cookie, and
# the customer app then serves no admin routes. MAILFORGE_ADMIN_URL is the console's public
# address (https in production). Compose: docker-compose.admin.yml. Guide: guide/ADMIN.md
# MAILFORGE_ADMIN_PORT=3011
# MAILFORGE_ADMIN_URL=https://admin.yourdomain.com
# MAILFORGE_ADMIN_HOST=0.0.0.0
# Passkeys on the admin console: off | optional (default) | enforced. With enforced, an
# administrator who has registered a passkey must use it (no emailed link). RP_ID is the site
# name passkeys are bound to; leave it unset unless you front the console with a different name.
# MAILFORGE_ADMIN_PASSKEYS=optional
# MAILFORGE_ADMIN_RP_ID=

# Days between a workspace owner asking to delete and permanent erasure (1 to 90).
# See guide/DATA.md
# MAILFORGE_DELETION_GRACE_DAYS=7

# Platform sender for account emails (sign-in links) for workspaces that have no
# email transport of their own. Set PLATFORM_FROM_EMAIL plus ONE of:
#   PLATFORM_RESEND_API_KEY=re_...
#   PLATFORM_SMTP_HOST / PLATFORM_SMTP_PORT / PLATFORM_SMTP_SECURE / PLATFORM_SMTP_USER / PLATFORM_SMTP_PASSWORD
# PLATFORM_FROM_EMAIL=no-reply@yourdomain.com
# PLATFORM_FROM_NAME=Your Product
