# Claros - Environment Configuration
# Copy to .env and fill in values.
#
# QUOTING: Always single-quote values that contain special characters
# (& $ # spaces etc). The .env parser handles single-quoted, double-quoted,
# and unquoted values. Single quotes are safest for connection strings.

# Edition: "community" (default) or "cloud"
CLAROS_EDITION=community

# Node environment: "development" for local/self-host dev, "production" for prod.
# Controls console login fallback (allowed only outside production).
# If unset, treated as production (fail-safe: closed).
NODE_ENV=development

# Postgres connection string (required).
# Single-quote values containing special chars (passwords with & $ # etc).
# Used by: Drizzle ORM (API queries) and pg-boss (job queue, separate pool).
# pg-boss creates its own "pgboss" schema here automatically on first start.
# Port 5433: the docker-compose stack maps container:5432 to host:5433
# to avoid collision with any host-installed Postgres on 5432.
# Also the default target for `pnpm db:migrate` (local migrations).
DATABASE_URL='postgres://claros:claros@localhost:5433/claros'

# Production database (Neon direct endpoint) - used only by `pnpm db:migrate -- --prod`.
# Self-hosters without Neon: leave this commented out. You only need DATABASE_URL.
# For Neon: use the DIRECT endpoint (no -pooler hostname, no ?pgbouncer=true).
# The migrate script refuses pooled endpoints and refuses to hit Neon without --prod.
# PRODUCTION_DATABASE_URL='postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require'

# Server
PORT=3000
HOST=0.0.0.0

# Bootstrap: initial admin email for first-boot seed.
# When the tenants table is empty AND this var is set, creates the default
# tenant and owner user. Ignored once a tenant exists. If the table is empty
# and this var is unset, the server logs an error and exits.
SEED_ADMIN_EMAIL='admin@example.com'

# Auto-migrate on startup (local/compose only).
# When exactly "true", applies pending community schema migrations on boot.
# NEVER set this in Cloud / against Neon - use scripts/migrate.sh instead.
# Absent or any other value = migrations do NOT run (fail-safe closed).
# docker-compose.yml sets this to true automatically.
# CLAROS_MIGRATE_ON_BOOT=true

# LLM provider (BYO key - OpenAI-compatible endpoint)
# Any endpoint implementing the /v1/chat/completions shape works.
# The provider must support response_format: { type: "json_object" } for
# reliable flow compilation. If it does not, compilation may still succeed
# (the system prompt instructs JSON output) but failures are more likely.
# In all cases, Zod schema validation catches non-conforming output and
# fails the compile cleanly rather than corrupting anything.
#
# Tested providers:
#   OpenAI:     baseUrl=https://api.openai.com/v1         model=gpt-4o
#               Supports response_format natively. Reference implementation.
#
#   Claude:     baseUrl=https://api.anthropic.com/v1/     model=claude-sonnet-4-6
#               Anthropic's OpenAI-compatible layer. No proxy needed.
#               Caveats:
#                 - response_format is IGNORED by this layer. JSON output relies
#                   on the system prompt instruction only; Zod validation catches
#                   non-conforming responses (compile fails, never corrupts).
#                 - Anthropic positions this layer as intended for testing and
#                   evaluation, not as a production-grade path. Self-hosters
#                   choosing Claude should be aware of this positioning.
#               See model names: https://docs.anthropic.com/en/docs/about-claude/models
#
#   Gemini:     baseUrl=https://generativelanguage.googleapis.com/v1beta/openai  model=gemini-2.0-flash
#               Supports response_format natively.
#
#   Groq:       baseUrl=https://api.groq.com/openai/v1    model=llama-3.3-70b-versatile
#               Supports response_format natively.
#
#   Ollama:     baseUrl=http://localhost:11434/v1          model=llama3
#               No API key needed. JSON mode support varies by model.
#
# LLM credentials are stored encrypted per-tenant in the llm_configs table.
# Write them via PUT /v1/settings/llm or the operator CLI:
#   echo '{"provider":"openai","api_key":"sk-...","base_url":"...","model":"gpt-4o"}' \
#     | node apps/server/bin/claros.mjs llm set <tenant_slug>
# The optional embedding_model field in the same JSON payload controls which
# model is used for KB entry embeddings (default: text-embedding-3-small,
# must produce vector(1536)).
# ENCRYPTION_KEY is required for this; see below.

# Encryption key for credentials at rest (LLM configs, transport configs).
# 32 bytes, base64-encoded (44 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required when storing or reading encrypted credentials. If unset, LLM config
# storage and flow compilation will fail with a clear error. The server still
# starts (the quickstart path does not need encryption until an LLM is configured).
# ENCRYPTION_KEY=

# Embedding model is configured as part of the LLM config (see above).
# The embedding_model field in the llm set JSON payload overrides the default.
# No separate embedding env vars: the same LLM config row provides the
# API key, base URL, and embedding model for both chat and embedding calls.

# Transport configuration (email provider credentials) is stored encrypted
# per-tenant in the transport_configs table. Write via PUT /v1/settings/transport
# or the operator CLI:
#   echo '{"provider":"resend","from_email":"hi@co.com","api_key":"re_..."}' \
#     | node apps/server/bin/claros.mjs transport set <tenant_slug>
# ENCRYPTION_KEY is required for this; see below.

# Auth
# No auth-specific env vars required. Sessions use database-stored UUIDs.
# Magic link delivery uses the configured transport (see above).

# Unsubscribe token signing key (HMAC-SHA256).
# Used to sign stateless unsubscribe tokens embedded in outgoing email headers.
# PERMANENT: this key cannot be rotated without breaking every unsubscribe link
# in already-delivered email, which is a compliance failure. Generate once,
# store permanently, back up securely. At least 32 random bytes, any encoding.
# A missing key fails closed: the drain reverts messages to 'approved' rather
# than sending without a valid signing key. The server starts without this key;
# sending is blocked until you set it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# UNSUBSCRIBE_SIGNING_KEY=

# Base URL for magic link generation (no trailing slash).
# Defaults to http://localhost:PORT in development.
# BASE_URL='http://localhost:3000'

# Seed concurrency test: dedicated isolated database for apps/server/tests/seed.test.ts.
# Must not share a database with other test suites (auth.test.ts etc.).
# Created automatically by docker-compose initdb (docker/initdb/01-seed-test-db.sh).
# No manual setup needed if you use the compose stack.
# SEED_TEST_DATABASE_URL='postgres://claros:claros@localhost:5433/claros_seed_test'

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Doctor command: override the /version URL used by `claros doctor`.
# Defaults to BASE_URL (--prod) or http://localhost:3000 (local).
# Set this when the API is behind a hostname not reflected in BASE_URL.
# CLAROS_DOCTOR_URL='https://app.example.com'
