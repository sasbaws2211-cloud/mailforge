# Claros - Environment Configuration
# Copy to .env and fill in values

# Edition: "community" (default) or "cloud"
CLAROS_EDITION=community

# Postgres connection string (required)
# For local dev: postgres://claros:claros@localhost:5432/claros
DATABASE_URL=postgres://claros:claros@localhost:5432/claros

# Server
PORT=3000
HOST=0.0.0.0

# LLM provider (BYO key - OpenAI-compatible endpoint)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Embedding endpoint (OpenAI-compatible, vector(1536))
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# Transport (configure at least one for sending)
# SES_REGION=eu-west-1
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=

# RESEND_API_KEY=

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Auth
# JWT_SECRET will be auto-generated on first run if not set
# JWT_SECRET=

# Log level: debug | info | warn | error
LOG_LEVEL=info
