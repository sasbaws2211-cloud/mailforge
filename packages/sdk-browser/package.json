{
  "name": "@loomail/browser",
  "version": "0.1.1",
  "description": "Browser client for Loomail: identify people and track events from any web app, with React and Vue helpers. Uses a publishable key.",
  "license": "MIT",
  "homepage": "https://loomail.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasbaws2211-cloud/mailforge.git",
    "directory": "packages/sdk-browser"
  },
  "bugs": {
    "url": "https://github.com/sasbaws2211-cloud/mailforge/issues"
  },
  "keywords": [
    "loomail",
    "analytics",
    "events",
    "lifecycle-email",
    "react",
    "nextjs",
    "vue",
    "nuxt",
    "browser",
    "tracking"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react.d.ts",
        "default": "./dist/esm/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/esm/vue.d.ts",
        "default": "./dist/esm/vue.js"
      },
      "require": {
        "types": "./dist/cjs/vue.d.ts",
        "default": "./dist/cjs/vue.js"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/esm/react.d.ts"
      ],
      "vue": [
        "./dist/esm/vue.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^25.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
