{
  "name": "@loomail/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assistant:docs": "tsx scripts/build-assistant-docs.ts",
    "assistant:docs:check": "tsx scripts/build-assistant-docs.ts --check",
    "content:freshness": "tsx scripts/content-freshness.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/static": "7.0.4",
    "@loomail/adapters": "workspace:*",
    "@loomail/brain-oss": "workspace:*",
    "@loomail/core": "workspace:*",
    "@loomail/db": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^4.28.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^20.14.0",
    "mssql": "12.7.10",
    "mysql2": "3.24.6",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
