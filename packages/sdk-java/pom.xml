<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>site.loomail</groupId>
  <artifactId>loomail</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>Loomail Java client</name>
  <description>Server-side client for Loomail: send identify and track events with a secret key. No dependencies; Java 11+.</description>
  <url>https://loomail.site</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>loomail</id>
      <name>Loomail</name>
      <email>admin@loomail.site</email>
      <url>https://loomail.site</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/sasbaws2211-cloud/mailforge/tree/main/packages/sdk-java</url>
    <connection>scm:git:https://github.com/sasbaws2211-cloud/mailforge.git</connection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <!-- The library compiles for Java 11; its tests use newer language features. -->
          <release>11</release>
          <testRelease>17</testRelease>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn -Prelease deploy: builds the sources and javadoc jars, signs everything with your GPG key and uploads the bundle
      to the Central Portal, where you review it and press Publish (autoPublish is off on purpose).
      Needs, on your machine only: a "central" server (your portal token) in ~/.m2/settings.xml, and your GPG passphrase in
      the MAVEN_GPG_PASSPHRASE environment variable. Nothing secret lives in this file.
      Without deploying: mvn -Prelease verify builds and signs but uploads nothing.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
                <configuration>
                  <!-- gpg 2.x asks for the passphrase in a dialog unless it is given on the command line side. Loopback lets
                       the plugin supply it from MAVEN_GPG_PASSPHRASE (or prompts in the terminal). -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
