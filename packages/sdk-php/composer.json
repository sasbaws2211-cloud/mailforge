{
  "name": "loomail/loomail",
  "description": "Server-side client for Loomail: send identify and track events with a secret key. Includes a Laravel service provider and facade.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://loomail.site",
  "keywords": [
    "loomail",
    "analytics",
    "events",
    "lifecycle-email",
    "laravel"
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "laravel/framework": "^10.0 || ^11.0 || ^12.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Loomail\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Loomail\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Loomail\\Laravel\\LoomailServiceProvider"
      ],
      "aliases": {
        "Loomail": "Loomail\\Laravel\\Facades\\Loomail"
      }
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
